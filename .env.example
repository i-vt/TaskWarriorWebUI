# ─────────────────────────────────────────────────────────────
# TaskWarrior WebUI — configuration
# install.sh copies this file to .env on first run.
# ─────────────────────────────────────────────────────────────

# Port the WebUI answers on (host side).
WEB_PORT=62304

# Address to bind on the host:
#   0.0.0.0     — all interfaces (reachable from your network)
#   127.0.0.1   — localhost only (use with your own reverse proxy)
BIND_ADDR=0.0.0.0

# HTTPS domain. Leave empty to serve plain HTTP on WEB_PORT (default).
# When set, an extra Caddy container is started: it serves
# https://<DOMAIN> with automatic Let's Encrypt certificates and proxies
# to the WebUI. Ports 80 and 443 must be reachable from the internet.
DOMAIN=

# Contact e-mail for Let's Encrypt expiry notifications (required when
# DOMAIN is set; harmless otherwise).
ACME_EMAIL=

# Default timezone for new accounts (IANA name, e.g. Europe/Berlin).
TIMEZONE=UTC

# Where all persistent data lives on the host (users, task databases,
# system log). Relative to the install directory unless absolute.
DATA_DIR=./data

# Number of gunicorn web workers.
WEB_WORKERS=2

# ── Telegram bot ─────────────────────────────────────────────
# Token from @BotFather. Leave empty to keep the bot container idle.
# After changing this value, run:  docker compose up -d bot
TELEGRAM_BOT_TOKEN=

# Seconds between reminder scans (checks every user's due/overdue tasks).
TELEGRAM_REMINDER_INTERVAL=60

# How many minutes before the due time a "due soon" reminder is sent.
TELEGRAM_DUE_SOON_MINUTES=60
